# SQLite by default -- zero setup. Swap for a postgres URL if you spin up docker-compose.
DATABASE_URL=sqlite:///./netpilot.db

# Any caller must present this bearer token to invoke a NetPilot tool.
# Generate your own for local dev, e.g.: python -c "import secrets; print(secrets.token_hex(16))"
NETPILOT_API_TOKEN=change-me-local-dev-token

# Comma-separated scopes granted to the token above.
# Available scopes: read, plan, mutate
NETPILOT_TOKEN_SCOPES=read,plan

LOG_LEVEL=INFO
AUDIT_LOG_PATH=./audit.log
